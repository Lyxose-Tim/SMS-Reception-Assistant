# Server (apps/server). Copy to .env at the repo root (the npm scripts load it) or set in your host's environment.
# APP_SECRET is required (>= 32 chars) and must stay stable: it encrypts merchants' AI keys. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
DATABASE_URL=file:./data/reception.db
TRUST_PROXY=false
# Max model-backed replies per business per day (then keyword rules answer)
# AI_DAILY_CALL_LIMIT=500
# Optional email notifications
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Reception Assistant <no-reply@example.com>
