# DOCUMENTATION ONLY: not auto-loaded. No actual credentials belong here.
# Use a private environment/secret manager outside the project and ZIP.
APP_MODE=demo
ENABLE_REAL_SEND=false

# Service mode: getpass prompt in python3 manage.py password-hash.
ADMIN_PASSWORD_HASH=
# Stable random server-only key, minimum 32 characters for live activation.
PRIVACY_HMAC_KEY=
# Local dry-run example; live requires a reviewed HTTPS origin.
ADMIN_ORIGIN=http://127.0.0.1:8765
# Empty trusts only the socket peer. Single-hop proxy must overwrite XFF.
# Example for the reviewed loopback Nginx template: 127.0.0.1/32
TRUSTED_PROXY_CIDRS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional least-privilege REST API key. Auth Token still validates webhooks.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Canonical external HTTPS origin, no path/query. Preserve raw callback query.
TWILIO_PUBLIC_BASE_URL=

# Test mode is the safe default. Formal mode needs its own recorded approval
# and only permits replies to verified, current inbound service inquiries.
RECIPIENT_POLICY=test_allowlist
INBOUND_SERVICE_APPROVAL_RECORDED=false
# Explicit authorized E.164 test recipients. Empty blocks live TEST mode.
TEST_RECIPIENT_ALLOWLIST=
# Match the ACTUAL number's configuration. Never modify account settings here.
TWILIO_OPT_OUT_PROFILE=standard
TWILIO_OPT_OUT_REVIEWED=false
CLIENT_READINESS_APPROVED=false
TEST_SEND_APPROVAL_RECORDED=false

MAX_MESSAGES_PER_MINUTE=5
MAX_MESSAGES_PER_DAY=40
MAX_SEGMENTS_PER_MESSAGE=3
MAX_DAILY_SEGMENTS=80
REPLY_WINDOW_HOURS=24
REQUEST_TIMEOUT_SECONDS=5
INBOUND_MAX_AGE_SECONDS=900
SESSION_TTL_SECONDS=3600
RETENTION_DAYS=30
# Optional absolute private path; existence blocks new send submissions.
EMERGENCY_STOP_FILE=

# Setting approval flags is not proof of approval or account registration.
# Application limits cannot guarantee the provider's final bill.
