# Template: replace hostname and certificate paths after separate deployment
# approval. Only signed webhooks are public; admin access denies everyone until
# the owner's VPN/CIDR is explicitly added. Never expose the Python port.
# After approval, set TRUSTED_PROXY_CIDRS=127.0.0.1/32 for this exact single hop.
# Each location OVERWRITES X-Forwarded-For with one client IP; never append an
# incoming chain or enable an unreviewed upstream real_ip configuration.
server {
    listen 80;
    server_name sms.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sms.example.invalid;
    ssl_certificate /etc/ssl/harbor-home/fullchain.pem;
    ssl_certificate_key /etc/ssl/harbor-home/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 32k;
    client_body_timeout 10s;
    # Webhook URI/query contains callback authentication nonces; access logging
    # is disabled. Do not enable body/header logging in a proxy or APM agent.
    access_log off;
    # Even upstream error logs may contain raw query/nonces. Use separately
    # reviewed metadata-only health monitoring instead of request-level logs.
    error_log /dev/null crit;

    location = /webhooks/twilio/sms {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_intercept_errors off;
    }
    location = /webhooks/twilio/status {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_intercept_errors off;
    }
    location / {
        # Add one approved owner/VPN address above 'deny all'. Do not change
        # this to 'allow all'; application login is an additional control.
        # allow 192.0.2.10/32;
        deny all;
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
