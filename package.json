{
  "name": "reception-assistant",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run dev -w @reception/server",
    "start:server": "npm run start -w @reception/server",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p apps/server/tsconfig.json"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
